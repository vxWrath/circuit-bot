# Template for .env - copy it and fill in the values.
#
#   cp .env.example .env
#
# Every variable the bot reads at startup, plus the credentials compose uses to
# create the Postgres and Redis services.  Nothing here is a real secret, and
# nothing in the file should become one that gets committed - .env is
# gitignored, this template is not.
#
# These parts are the whole configuration: the bot assembles its connection
# settings from them at runtime (src/circuit_bot/config.py) rather than reading a
# ready-made URL, so there is no DSN to keep in step with the credentials below.
# A host run and a container differ only in the host, and compose supplies that.
#
# Comments must sit on their own line: nothing after a value is stripped.

# console log renderer in dev, JSON in prod.  Defaults to dev when unset.
STAGE=dev


# --- Discord ----------------------------------------------------------------

# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN="your-discord-bot-token"


# --- Bloxlink ---------------------------------------------------------------

# https://blox.link/dashboard/developer
#
# Required at startup: CircuitBot builds BloxlinkClient eagerly and its
# constructor reads this.  An empty value passes that check, so a blank key
# boots the bot and then 401s on every Bloxlink call rather than failing loudly.
BLOXLINK_API_KEY="your-bloxlink-api-key"


# --- Postgres ---------------------------------------------------------------
#
# The compose service creates its database from these on first run, and the bot
# dials them.  Host and port default to localhost:5432 if unset; the credentials
# and the database name have no default, so a missing password stops startup
# instead of connecting as something nobody chose.
#
# POSTGRES_HOST is the one value compose overrides - `postgres`, the service
# name.  POSTGRES_PORT means "the port Postgres is reachable on at that host":
# for a host run that is the port compose publishes (it publishes this value), and
# for the container compose pins it to 5432, which is where the service listens.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD="pick-a-password"
POSTGRES_DB=circuit

# Editing POSTGRES_PASSWORD after the first run does nothing by itself: postgres
# applies it only when initializing an empty data directory, so an existing volume
# keeps the old password and every connection then fails with "password
# authentication failed for user".  To actually change it, discard the volume and
# let it initialize again - this drops the database with it:
#
#   docker compose rm -sf postgres && docker volume rm circuit-bot_postgres-data
#   docker compose up -d postgres


# --- Redis ------------------------------------------------------------------
#
# Same shape as the Postgres block: host and port default to localhost:6379, the
# password has no default, and REDIS_DB is the database index, 0 if unset.
# compose overrides REDIS_HOST with the service name and pins REDIS_PORT to 6379.

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD="pick-a-password"
REDIS_DB=0

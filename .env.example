# Copy to .env and fill in:  cp .env.example .env
#
# The bot builds its connection settings from these parts at runtime, so there is
# no URL to keep in step.  A host run and a container differ only in the host.
# Comments must be on their own line; nothing after a value is stripped.

STAGE=dev

# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN="your-discord-bot-token"

# https://blox.link/dashboard/developer
# Required at startup.  An empty value passes get_env() but 401s on every call.
BLOXLINK_API_KEY="your-bloxlink-api-key"

# compose overrides POSTGRES_HOST with the service name and pins POSTGRES_PORT
# to 5432.  For a host run, HOST and PORT default to localhost:5432; USER,
# PASSWORD and DB are required.
#
# Changing POSTGRES_PASSWORD later means dropping the volume:
#   docker volume rm circuit-bot_postgres-data

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD="pick-a-password"
POSTGRES_DB=circuit

# Same shape.  HOST and PORT default to localhost:6379 and REDIS_DB to 0;
# REDIS_PASSWORD is required.

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD="pick-a-password"
REDIS_DB=0

# -- Runtime ---------------------------------------------------------------
STAGE=dev
# Optional. Defaults to a file in the system temp directory.
# SYNC_SENTINEL=/path/to/sync.sentinel
# Optional. Path to the league settings file (defaults to ./config.toml).
# CONFIG_PATH=/path/to/config.toml

# -- Discord ---------------------------------------------------------------
DISCORD_TOKEN="your-discord-bot-token"
GUILD_ID="your-guild-id"
CONNECTION_WEBHOOK_URL="your-connection-webhook-url"
ERROR_WEBHOOK_URL="your-error-webhook-url"

# -- Roblox --------------------------------------------------------------
ROBLOX_API_KEY="your-roblox-api-key"
BLOXLINK_API_KEY="your-bloxlink-api-key"

# -- Postgres --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD="pick-a-password"
POSTGRES_DB=circuit

# -- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD="pick-a-password"
REDIS_DB=0

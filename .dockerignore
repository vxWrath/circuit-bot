# uv sync needs pyproject.toml, uv.lock, README.md and src/.

.git
.gitignore

.venv
__pycache__/
*.py[oc]
.ruff_cache/
.pytest_cache/

# Secrets arrive as environment variables; a baked-in .env stays in the layers.
.env
.env.*

docs/
tools/
out/

# README.md is excepted - pyproject.toml names it as the project readme.
*.md
!README.md
